{
  "permissions": {
    "defaultMode": "auto"
  },
  "model": "sonnet",
  "worktree": {
    "baseRef": "fresh"
  },
  "statusLine": {
    "type": "command",
    "command": "~/.claude/statusline.sh"
  },
  "language": "Español",
  "feedbackDrafts": "quiet",
  "spinnerTipsEnabled": false,
  "pluginConfigs": {
    "cc-plugin-agents-md@builtin": {
      "options": {
        "instructionFiles": "claude-md-or-agents-md"
      }
    }
  },
  "timeFormat": "24-hour",
  "theme": "auto",
  "editorMode": "normal",
  "verbose": false,
  "autoContinueAtUsageLimit": false,
  "terminalProgressBarEnabled": true,
  "hooks": {
    "SessionStart": [
      {
        "matcher": "startup|clear",
        "hooks": [
          {
            "type": "command",
            "command": "~/.claude/hooks/handoff-inicio.sh"
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "~/.claude/hooks/bloquea-compilar.sh"
          }
        ]
      },
      {
        "matcher": "Edit|Write|NotebookEdit",
        "hooks": [
          {
            "type": "command",
            "command": "~/.claude/hooks/pide-confirmar-edicion.sh"
          }
        ]
      }
    ]
  }
}
