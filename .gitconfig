[user]
    name = Vicente Gimeno
    email = vgimeno@tunelia.com
[core]
    editor = vim
    filemode = false
    autocrlf = input
[pull]
    rebase = false
[fetch]
    prune = false
[rebase]
    autoStash = false
[credential "http://192.168.60.10:10080"]
    username = vgimeno
    provider = gitlab
[diff]
    tool = vimdiff
[difftool]
    prompt = false
[difftool "vimdiff"]
    path = /usr/bin/vimdiff
    keepBackup = false
    trustExitcode = false
[merge]
    tool = winmerge
[mergetool "winmerge"]
    cmd = git_merge.sh "$LOCAL" "$REMOTE"
    trustExitCode = true
    keepBackup = false
[alias]
    d = difftool
   m = mergetool
[credential]
    helper = store
[safe]
    directory = C:/work/soft/shd
    directory = C:/work/soft/hlib
    directory = C:/work/soft/timap
    directory = C:/work/soft/000_misc/modbus
    directory = C:/work/soft/jarvis
[filter "lfs"]
    clean = git-lfs clean -- %f
    smudge = git-lfs smudge -- %f
    process = git-lfs filter-process
    required = true
[pager]
    branch = less -F -X
    log = less -F -X
    diff = less -F -X
[credential "http://git.tunelia.com"]
	provider = generic
